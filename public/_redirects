# Cloudflare Pages SPA routing
#
# robots.txt and sitemap.xml are served directly from api.sc-market.space (see
# the backend's sitemap.routes.ts); the frontend's public/robots.txt points
# crawlers there. The only Functions are the route-scoped edge bridge
# (functions/<prefix>/[[path]].ts, plus functions/index.ts for "/" only; see
# src/bridge/handler.ts), limited to public page paths by public/_routes.json
# ("/" is an exact rule, never "/*"). Never add a root _middleware.ts: it
# would intercept every static asset and burn the Functions invocation budget.

# Missing files under /assets/ and /content/ must return a real 404, NOT fall
# through to the SPA catch-all below and get served index.html as 200
# text/html. Cloudflare Pages has no 404 status in this file (a
# "/assets/*  /assets/:splat  404" rule is ignored), so that is done with a
# 404.html in each directory instead: public/assets/404.html (a stale chunk
# must fail to load so client recovery reloads) and public/content/404.html
# (the edge bridge and the backend sitemap read the content build's JSON).

# Typed-URL alias for Help & Guides (the SPA also redirects client-side).
/help        /guides           301

# Legal pages moved from the Termly export names to /terms and /privacy
# (public/terms.html, public/privacy.html; Pages serves them extensionless).
/terms-of-service       /terms     301
/terms-of-service.html  /terms     301
/privacy-policy         /privacy   301
/privacy-policy.html    /privacy   301

# Every other app path gets the SPA shell (React Router's SPA fallback; the
# homepage and the pages in src/prerender/paths.ts are their own files, which
# Pages serves first).
/*    /__spa-fallback.html   200
