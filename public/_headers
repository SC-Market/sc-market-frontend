/*
  Access-Control-Allow-Origin: https://api.sc-market.space
  Access-Control-Allow-Credentials: true
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# HSTS on the main site only: white-label custom domains are served by this
# same project and must not get it. No includeSubDomains (not every
# *.sc-market.space host is confirmed to serve https) and no preload. The edge
# bridge (src/bridge/handler.ts HSTS_HEADER) sends the same value.
https://sc-market.space/*
  Strict-Transport-Security: max-age=31536000

https://www.sc-market.space/*
  Strict-Transport-Security: max-age=31536000

# Web Linking (RFC 8288) headers advertising machine-readable entry points for
# agents/tooling. The API and its catalog live on the api. subdomain, so these
# are absolute cross-origin URLs. api-catalog rel is from RFC 9727; service-desc
# (the OpenAPI spec) and service-doc (the human docs UI) are from RFC 8631.
/
  Link: <https://api.sc-market.space/.well-known/api-catalog>; rel="api-catalog", <https://api.sc-market.space/api/v2/openapi.json>; rel="service-desc"; type="application/json", <https://api.sc-market.space/docs>; rel="service-doc"; type="text/html"

# Service worker: never cache at the edge/browser, so a new deploy's sw.js is
# always fetched fresh and the SW update logic can run. A stale sw.js is the
# classic cause of clients being stuck on an old app version after deploy.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# App shell: always revalidate so the served index.html references the current
# hashed /assets/* chunks. A stale shell points at chunks that no longer exist
# after a deploy → "error loading dynamically imported module".
/index.html
  Cache-Control: no-cache

# Hashed build assets are content-addressed (filename changes when content
# changes), so they are safe to cache forever/immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
